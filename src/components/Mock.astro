---
// معاينات «بعد»: واجهات مرسومة بالكود ببيانات وهمية (لا صور ولا أسماء حقيقية)
const { type, lang = "ar", title = "" } = Astro.props;
const L = (ar, en) => (lang === "en" ? en : ar);
const days = L(["أحد", "اثنين", "ثلاثاء", "أربعاء", "خميس"], ["Sun", "Mon", "Tue", "Wed", "Thu"]);
---
<div class={`mock mock-${type}`} aria-hidden="true">
  <div class="bar">
    <span class="dot"></span>
    <span class="app">{title}</span>
    <span class="live">{L("مباشر", "Live")}</span>
  </div>

  {type === "booking" && (
    <div class="body booking">
      <div class="cal">
        <div class="cal-h"><span></span>{days.map((d) => <span>{d}</span>)}</div>
        {[1, 2, 3, 4, 5].map((h, i) => (
          <div class="cal-r">
            <span class="hall">{L(`قاعة ${h}`, `Hall ${h}`)}</span>
            {days.map((_, j) => (
              <span class="slot">
                {(i + j) % 3 === 0 && <i class={`ev e${(i + j) % 4}`}>{["CPD", "BLS", L("محاضرة", "Lecture"), L("اجتماع", "Meeting")][(i + j) % 4]}</i>}
              </span>
            ))}
          </div>
        ))}
      </div>
      <div class="side">
        <div class="req">
          <b>{L("طلب حجز جديد", "New booking request")}</b>
          <span>{L("جهة خارجية: ورشة تدريبية", "External tenant: workshop")}</span>
          <span>{L("قاعة 3 — الثلاثاء 9:00", "Hall 3 — Tue 9:00")}</span>
          <em class="ok">{L("لا يوجد تعارض", "No clash")}</em>
        </div>
        <div class="toast">{L("أُرسل إشعار بالبريد للمنسق", "Email sent to coordinator")}</div>
      </div>
    </div>
  )}

  {type === "attendance" && (
    <div class="body attendance">
      <div class="kpis">
        <div><small>{L("نسبة الحضور", "Attendance")}</small><b>94%</b></div>
        <div><small>{L("متدربون", "Trainees")}</small><b>148</b></div>
        <div><small>{L("أوراق مؤرشفة", "Sheets archived")}</small><b>1,260</b></div>
      </div>
      <div class="bars">
        {[[L("الباطنة", "Medicine"), 92], [L("الأعصاب", "Neurology"), 97], [L("الطوارئ", "Emergency"), 88], [L("الجراحة", "Surgery"), 90], [L("الأطفال", "Pediatrics"), 95]].map(([n, v]) => (
          <div class="b"><span class="bn">{n}</span><span class="bt"><i style={`inline-size:${v}%`}></i></span><span class="bv">{v}%</span></div>
        ))}
      </div>
      <ul class="people">
        {[["ok", L("حاضر", "Present")], ["ok", L("حاضر", "Present")], ["warn", L("إجازة", "Leave")], ["bad", L("غائب", "Absent")]].map(([c, t], i) => (
          <li><span class="av">{L("م", "R")}{i + 1}</span><span>{L(`طبيب مقيم ${i + 1}`, `Resident ${i + 1}`)}</span><em class={c}>{t}</em></li>
        ))}
      </ul>
    </div>
  )}

  {type === "portal" && (
    <div class="body portal">
      <ul class="nav">
        {[L("نظرة تنفيذية", "Executive"), L("التدريب السريري", "Clinical"), L("الإقامة", "Residency"), L("دعم الحياة", "Life support"), L("التعليم المستمر", "CPD")].map((t, i) => <li class={i === 0 ? "cur" : ""}>{t}</li>)}
      </ul>
      <div class="main">
        <div class="kpis">
          <div><small>{L("متدربون نشطون", "Active trainees")}</small><b>312</b></div>
          <div><small>{L("إيراد الشهر", "Monthly revenue")}</small><b>{L("418 ألف", "418K")}</b></div>
          <div><small>{L("دورات", "Courses")}</small><b>27</b></div>
        </div>
        <svg class="chart" viewBox="0 0 300 90" preserveAspectRatio="none">
          <path d="M0 70 L40 62 L80 66 L120 48 L160 52 L200 34 L240 38 L300 18" fill="none" stroke="var(--volt)" stroke-width="2.5" vector-effect="non-scaling-stroke" />
          <path d="M0 70 L40 62 L80 66 L120 48 L160 52 L200 34 L240 38 L300 18 L300 90 L0 90Z" fill="var(--volt-soft)" opacity=".7" />
          <path d="M0 80 L60 76 L120 72 L180 70 L240 62 L300 58" fill="none" stroke="var(--ink)" stroke-width="1.5" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
        </svg>
        <div class="split">
          <div class="donut"><i></i><span>68%<small>{L("تحصيل", "Collected")}</small></span></div>
          <ul class="legend">
            <li><i style="background:var(--volt)"></i>{L("السريري", "Clinical")}</li>
            <li><i style="background:var(--ink)"></i>{L("الإقامة", "Residency")}</li>
            <li><i style="background:#8fb0ff"></i>CPD</li>
          </ul>
        </div>
      </div>
    </div>
  )}

  {type === "accreditation" && (
    <div class="body accreditation">
      <div class="ring" style="--v:92"><span>92%<small>{L("جاهزية", "Ready")}</small></span></div>
      <ul class="std">
        {[["ATA1", L("الحوكمة والسياسات", "Governance & policies"), 100, "ok"], ["ATA2", L("الموارد والمدربون", "Resources & trainers"), 95, "ok"], ["P-04", L("التقييم والاختبارات", "Assessment"), 86, "warn"], ["P-07", L("محاضر اللجان", "Committee minutes"), 70, "warn"], ["P-09", L("رضا المتدربين", "Trainee feedback"), 100, "ok"]].map(([c, n, v, s]) => (
          <li><code>{c}</code><span class="sn">{n}</span><span class="bt"><i class={s} style={`inline-size:${v}%`}></i></span><em class={s}>{v === 100 ? L("مكتمل", "Done") : `${v}%`}</em></li>
        ))}
      </ul>
    </div>
  )}

  {type === "files" && (
    <div class="body files">
      <div class="who">
        <span class="av big">{L("م", "R")}</span>
        <div><b>{L("طبيب مقيم — سنة ثانية", "Resident — PGY-2")}</b><small>{L("برنامج الباطنة", "Internal medicine")}</small></div>
      </div>
      <ul class="lic">
        {[[L("ترخيص الهيئة", "SCFHS licence"), L("ساري حتى 2027", "Valid to 2027"), "ok"], ["BLS", L("ينتهي خلال 24 يوماً", "Expires in 24 days"), "warn"], ["ACLS", L("منتهٍ — يلزم التجديد", "Expired — renew"), "bad"], [L("الاختبار الشهري", "Monthly exam"), "84 / 100", "ok"]].map(([n, v, s]) => (
          <li><span class={`pill ${s}`}></span><span class="ln">{n}</span><em class={s}>{v}</em></li>
        ))}
      </ul>
      <div class="att">
        {[L("السيرة الذاتية", "CV"), L("الترخيص", "Licence"), L("الشهادات", "Certificates"), L("التقييمات", "Evaluations")].map((t) => <span>{t}</span>)}
      </div>
    </div>
  )}

  {type === "report" && (
    <div class="body report">
      <ul class="tl">
        {[["7:30", L("التقرير الصباحي — حالة جلطة دماغية", "Morning report — stroke case")], ["8:15", L("مرور سريري", "Ward round")], ["12:00", L("نادي المجلة", "Journal club")]].map(([t, n], i) => (
          <li class={i === 0 ? "now" : ""}><time>{t}</time><span>{n}</span></li>
        ))}
      </ul>
      <div class="heat">
        <div class="hh">{days.map((d) => <span>{d}</span>)}</div>
        {[0, 1, 2, 3].map((r) => (
          <div class="hr">{days.map((_, c) => <i class={`h${(r * 3 + c * 2) % 4}`}></i>)}</div>
        ))}
        <small>{L("مشاركة الأطباء هذا الأسبوع", "Doctors' participation this week")}</small>
      </div>
    </div>
  )}

  {type === "assistant" && (
    <div class="body assistant">
      <p class="q">{L("كيف أحجز قاعة لنشاط من جهة خارجية؟", "How do I book a hall for an external event?")}</p>
      <div class="a">
        <span class="ai"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg></span>
        <div>
          <p>{L("عبّئ نموذج طلب الحجز للمستأجرين، وسيصلك تأكيد بالبريد بعد مراجعة التعارض. يلزم إرفاق خطاب الجهة.", "Fill in the tenant booking form; you'll get an email confirmation after a clash check. Attach the organisation's letter.")}</p>
          <span class="src">{L("المصدر: سياسة حجز القاعات، البند 3", "Source: Hall booking policy, item 3")}</span>
        </div>
      </div>
      <div class="input"><span>{L("اكتب سؤالك…", "Ask a question…")}</span><i></i></div>
    </div>
  )}

  {type === "wathiq" && (
    <div class="body wathiq">
      <div class="tenant"><b>{L("جمعية تجريبية", "Demo association")}</b><em>{L("تجربة مجانية: 12 يوماً", "Free trial: 12 days")}</em></div>
      <div class="mods">
        {[L("الحوكمة", "Governance"), L("المستفيدون", "Beneficiaries"), L("الموارد البشرية", "HR"), L("المشاريع", "Projects"), L("المؤشرات", "KPIs"), L("التبرعات", "Donations")].map((m, i) => (
          <div class="mod"><span class={`ic c${i % 3}`}></span>{m}</div>
        ))}
      </div>
      <div class="kline"><span>{L("مؤشر الامتثال", "Compliance index")}</span><span class="bt"><i style="inline-size:81%"></i></span><b>81%</b></div>
    </div>
  )}

  {type === "library" && (
    <div class="body library">
      <div class="shelf">
        {["#0b1e3f", "#1847d6", "#22355c", "#44536d", "#1847d6", "#13294f", "#1c4fd8", "#0b1e3f"].map((c, i) => (
          <span class="book" style={`--c:${c}`}><i>{L(`المجلد ${i + 1}`, `Vol. ${i + 1}`)}</i></span>
        ))}
      </div>
      <div class="spread"><span></span><span></span></div>
    </div>
  )}

  {type === "legal" && (
    <div class="body legal">
      <table>
        <thead><tr><th>{L("العقد", "Contract")}</th><th>{L("النوع", "Type")}</th><th>{L("الحالة", "Status")}</th></tr></thead>
        <tbody>
          {[["C-104", L("أتعاب", "Fees"), "ok", L("ساري", "Active")], ["C-105", L("وكالة", "POA"), "warn", L("تنتهي قريباً", "Expiring")], ["C-106", L("استشارة", "Advisory"), "ok", L("ساري", "Active")], ["C-107", L("أتعاب", "Fees"), "bad", L("متأخر", "Overdue")]].map(([n, t, s, l]) => (
            <tr><td><code>{n}</code></td><td>{t}</td><td><em class={s}>{l}</em></td></tr>
          ))}
        </tbody>
      </table>
      <div class="session"><b>{L("جلسة غداً 10:00", "Session tomorrow 10:00")}</b><span>{L("أُضيفت للتقويم وأُرسل تذكير", "Added to calendar, reminder sent")}</span></div>
    </div>
  )}

  {type === "fund" && (
    <div class="body fund">
      <div class="card">
        <small>{L("رصيد الصندوق", "Fund balance")}</small>
        <b>{L("184,500 ر.س", "SAR 184,500")}</b>
        <span>{L("62 عضواً", "62 members")}</span>
      </div>
      <div class="loan">
        <div class="lh"><span>{L("قرض حسن — عضو 17", "Loan — member 17")}</span><em class="ok">{L("منتظم", "On track")}</em></div>
        <div class="steps">{Array.from({ length: 10 }).map((_, i) => <i class={i < 6 ? "paid" : ""}></i>)}</div>
        <small>{L("سُدد 6 من 10 أقساط", "6 of 10 instalments paid")}</small>
      </div>
    </div>
  )}

  {type === "excel" && (
    <div class="body excel">
      <div class="tabs">{[L("الحوكمة", "Governance"), L("الحضور", "Attendance"), L("الموارد البشرية", "HR"), L("الرواتب", "Payroll")].map((t, i) => <span class={i === 3 ? "cur" : ""}>{t}</span>)}</div>
      <div class="grid">
        {[[L("الموظف", "Employee"), L("الأساسي", "Basic"), L("البدلات", "Allow."), L("نهاية الخدمة", "EOS")], [L("موظف 1", "Staff 1"), "6,000", "1,500", "18,250"], [L("موظف 2", "Staff 2"), "5,200", "1,300", "9,880"], [L("موظف 3", "Staff 3"), "7,500", "1,875", "31,400"], [L("الإجمالي", "Total"), "18,700", "4,675", "59,530"]].map((r, i) => (
          <div class={`row ${i === 0 ? "hd" : ""} ${i === 4 ? "tot" : ""}`}>{r.map((c) => <span>{c}</span>)}</div>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  .mock { --r: 10px; background: var(--white); border-radius: var(--radius-frame); border: 1px solid var(--mist); box-shadow: 0 1px 0 rgba(11,30,63,.04), 0 24px 48px -28px rgba(11,30,63,.35); overflow: hidden; font-family: var(--f-body); font-size: 12.5px; line-height: 1.45; color: var(--ink-2); block-size: 100%; display: flex; flex-direction: column; }
  .bar { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-bottom: 1px solid var(--mist-2); background: #fbfcfe; }
  .bar .dot { inline-size: 8px; block-size: 8px; border-radius: 50%; background: var(--volt); box-shadow: 0 0 0 3px var(--volt-soft); }
  .bar .app { font-family: var(--f-display); font-weight: 600; color: var(--ink); font-size: 12.5px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .bar .live { margin-inline-start: auto; font-size: 11px; color: #0f7a59; display: flex; align-items: center; gap: 5px; }
  .bar .live::before { content: ""; inline-size: 6px; block-size: 6px; border-radius: 50%; background: var(--ok); }
  .body { padding: 14px; flex: 1; min-block-size: 0; }
  b { color: var(--ink); font-family: var(--f-display); font-weight: 600; }
  small { color: var(--slate); font-size: 11px; display: block; }
  em { font-style: normal; font-size: 11px; padding: 2px 8px; border-radius: 999px; white-space: nowrap; }
  em.ok { background: #e3f6ef; color: #0b6b4f; } em.warn { background: #fdf1dc; color: #8a5300; } em.bad { background: #fde6e6; color: #a12828; }
  code { font-family: var(--f-body); font-size: 10.5px; background: var(--mist-2); color: var(--ink); padding: 1px 6px; border-radius: 4px; direction: ltr; }
  .bt { display: block; block-size: 6px; background: var(--mist-2); border-radius: 9px; overflow: hidden; }
  .bt i { display: block; block-size: 100%; background: var(--volt); border-radius: 9px; }
  .bt i.warn { background: var(--warn); } .bt i.ok { background: var(--volt); }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .kpis > div { background: var(--mist-2); border-radius: 8px; padding: 8px 10px; }
  .kpis b { font-size: 17px; display: block; }

  /* booking */
  .booking { display: grid; grid-template-columns: 1fr 150px; gap: 12px; }
  .cal { display: grid; gap: 4px; }
  .cal-h, .cal-r { display: grid; grid-template-columns: 46px repeat(5, 1fr); gap: 4px; }
  .cal-h span { font-size: 10.5px; color: var(--slate); text-align: center; }
  .hall { font-size: 10.5px; color: var(--ink); align-self: center; }
  .slot { block-size: 30px; border-radius: 6px; background: var(--mist-2); display: flex; padding: 3px; }
  .ev { flex: 1; border-radius: 4px; font-style: normal; font-size: 9.5px; padding: 2px 4px; color: #fff; overflow: hidden; white-space: nowrap; }
  .e0 { background: var(--volt-deep); } .e1 { background: var(--ink); } .e2 { background: #8fb0ff; color: var(--ink); } .e3 { background: #22355c; }
  .side { display: flex; flex-direction: column; gap: 8px; }
  .req { border: 1px solid var(--mist); border-radius: 8px; padding: 10px; display: flex; flex-direction: column; gap: 4px; font-size: 11px; }
  .req em { align-self: flex-start; margin-top: 4px; }
  .toast { background: var(--ink); color: #fff; border-radius: 8px; padding: 8px 10px; font-size: 11px; }

  /* attendance */
  .attendance { display: grid; gap: 12px; }
  .bars { display: grid; gap: 7px; }
  .b { display: grid; grid-template-columns: 64px 1fr 32px; align-items: center; gap: 8px; font-size: 11px; }
  .bv { color: var(--ink); text-align: end; }
  .people { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .people li { display: flex; align-items: center; gap: 6px; font-size: 11px; border: 1px solid var(--mist-2); border-radius: 8px; padding: 5px 6px; }
  .people em { margin-inline-start: auto; }
  .av { inline-size: 22px; block-size: 22px; border-radius: 50%; background: var(--volt-soft); color: var(--volt-deep); display: grid; place-items: center; font-size: 9.5px; font-weight: 600; flex: none; }
  .av.big { inline-size: 44px; block-size: 44px; font-size: 16px; }

  /* portal */
  .portal { display: grid; grid-template-columns: 112px 1fr; gap: 12px; }
  .portal .nav { list-style: none; display: grid; gap: 3px; align-content: start; }
  .portal .nav li { padding: 6px 8px; border-radius: 6px; font-size: 11px; color: var(--slate); }
  .portal .nav li.cur { background: var(--ink); color: #fff; }
  .portal .main { display: grid; gap: 10px; min-inline-size: 0; }
  .chart { inline-size: 100%; block-size: 78px; }
  :global([dir="rtl"]) .chart { transform: scaleX(-1); }
  .split { display: flex; align-items: center; gap: 14px; }
  .donut { position: relative; inline-size: 66px; block-size: 66px; border-radius: 50%; background: conic-gradient(var(--volt) 0 46%, var(--ink) 46% 78%, #8fb0ff 78% 100%); flex: none; }
  .donut i { position: absolute; inset: 10px; border-radius: 50%; background: #fff; }
  .donut span { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; font-family: var(--f-display); font-weight: 600; color: var(--ink); font-size: 13px; line-height: 1.1; }
  .donut small { font-size: 8.5px; }
  .legend { list-style: none; display: grid; gap: 4px; font-size: 11px; }
  .legend i { display: inline-block; inline-size: 8px; block-size: 8px; border-radius: 2px; margin-inline-end: 6px; }

  /* accreditation */
  .accreditation { display: grid; grid-template-columns: 96px 1fr; gap: 16px; align-items: center; }
  .ring { --v: 90; inline-size: 92px; block-size: 92px; border-radius: 50%; background: conic-gradient(var(--volt) calc(var(--v) * 1%), var(--mist-2) 0); position: relative; display: grid; place-items: center; }
  .ring::before { content: ""; position: absolute; inset: 9px; background: #fff; border-radius: 50%; }
  .ring span { position: relative; font-family: var(--f-display); font-weight: 700; color: var(--ink); font-size: 20px; text-align: center; line-height: 1.05; }
  .std { list-style: none; display: grid; gap: 8px; }
  .std li { display: grid; grid-template-columns: 40px 1fr 70px 52px; gap: 8px; align-items: center; font-size: 11px; }
  .std .sn { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .std em { text-align: center; }

  /* files */
  .files { display: grid; gap: 12px; }
  .who { display: flex; gap: 10px; align-items: center; }
  .lic { list-style: none; display: grid; gap: 6px; }
  .lic li { display: flex; align-items: center; gap: 8px; padding: 7px 8px; border: 1px solid var(--mist-2); border-radius: 8px; }
  .lic .ln { flex: 1; color: var(--ink); }
  .pill { inline-size: 4px; align-self: stretch; border-radius: 4px; }
  .pill.ok { background: var(--ok); } .pill.warn { background: var(--warn); } .pill.bad { background: var(--bad); }
  .att { display: flex; flex-wrap: wrap; gap: 6px; }
  .att span { font-size: 10.5px; padding: 4px 8px; border: 1px dashed #b9c4d8; border-radius: 6px; color: var(--slate); }

  /* report */
  .report { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .tl { list-style: none; display: grid; gap: 8px; border-inline-start: 2px solid var(--mist); padding-inline-start: 12px; }
  .tl li { position: relative; display: grid; font-size: 11px; }
  .tl li::before { content: ""; position: absolute; inset-inline-start: -18px; top: 4px; inline-size: 10px; block-size: 10px; border-radius: 50%; background: #fff; border: 2px solid var(--mist); }
  .tl li.now::before { background: var(--volt); border-color: var(--volt); }
  .tl time { color: var(--slate); font-size: 10.5px; }
  .heat { display: grid; gap: 4px; align-content: start; }
  .hh, .hr { display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; }
  .hh span { font-size: 9.5px; color: var(--slate); text-align: center; }
  .hr i { block-size: 18px; border-radius: 4px; }
  .h0 { background: var(--mist-2); } .h1 { background: #c3d4ff; } .h2 { background: #7fa3ff; } .h3 { background: var(--volt); }

  /* assistant */
  .assistant { display: flex; flex-direction: column; gap: 10px; }
  .q { align-self: flex-end; background: var(--ink); color: #fff; padding: 8px 12px; border-radius: 12px; border-end-end-radius: 4px; max-inline-size: 80%; }
  .a { display: flex; gap: 8px; align-items: flex-start; max-inline-size: 92%; }
  .a > div { background: var(--mist-2); padding: 9px 12px; border-radius: 12px; border-start-start-radius: 4px; display: grid; gap: 6px; }
  .ai { inline-size: 26px; block-size: 26px; border-radius: 8px; background: var(--volt); color: #fff; display: grid; place-items: center; flex: none; }
