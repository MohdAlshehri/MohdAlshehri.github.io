---
import Layout from "../layouts/Layout.astro";
import BeforeAfter from "./BeforeAfter.astro";
import Icon from "./Icon.astro";
import { site, contact, journey, achievements, certifications, recommendations, tools } from "../data/site.js";
import { workProjects, productProjects } from "../data/projects.js";
import { tx, workUrl } from "../data/i18n.js";

const { lang = "ar" } = Astro.props;
const s = site[lang];
const l = s.labels;
const strengthIcons = ["discover", "flow", "spark", "precise"];
---
<Layout lang={lang} onHome>
  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="who">{s.name}<span class="who-role">{s.title}</span></p>
        <h1 id="hero-title">{s.heroLead}</h1>
        <p class="lead">{s.heroBody}</p>
        <div class="ctas">
          <a class="btn btn-solid" href="#work">{s.heroCtaWork}</a>
          <a class="btn btn-ghost" href={contact.whatsapp} target="_blank" rel="noopener">{s.heroCtaContact}</a>
        </div>
        <ul class="focus">
          {s.focus.map((f) => <li>{f}</li>)}
        </ul>
      </div>
      <figure class="portrait">
        <div class="photo"><img src="/images/mohammed.webp" alt={s.name} width="895" height="1088" fetchpriority="high" /></div>
        <figcaption class="badge">
          <Icon name="shield" size={22} />
          <span>{s.classification}</span>
        </figcaption>
      </figure>
    </div>

    <!-- الخط: يبدأ خربشة يدوية ثم يستقيم نظاماً، وينزل ليكمل الصفحة -->
    <div class="strip wrap" aria-hidden="true">
      <svg class="strip-d" viewBox="0 0 2000 150" preserveAspectRatio="xMinYMin slice">
        <path d="M840 64 C812 8 772 22 790 52 C806 80 758 96 744 60 C730 24 704 14 712 46 C720 78 684 90 670 58 C656 26 628 30 640 56 C652 84 610 92 600 62 C590 34 566 40 574 60 C582 80 548 76 536 58 L500 58 L40 58 Q2 58 1 96 L1 150" />
      </svg>
      <svg class="strip-m" viewBox="0 0 1000 150" preserveAspectRatio="xMinYMin slice">
        <path d="M360 64 C344 18 318 26 328 52 C338 78 306 90 298 60 C290 30 272 24 278 50 C284 76 258 84 250 58 C242 34 226 38 232 58 C238 78 214 76 206 58 L30 58 Q2 58 1 96 L1 150" />
      </svg>
      <span class="tag tag-hand">{lang === "en" ? "manual process" : "إجراء يدوي"}</span>
      <span class="tag tag-sys">{lang === "en" ? "digital system" : "نظام رقمي"}</span>
    </div>
  </section>

  <div class="lined">
    <div class="rail"><div class="fill"></div></div>
    <div class="inner">

      <!-- ============ طريقة العمل ============ -->
      <section class="method" aria-label={lang === "en" ? "How I work" : "طريقتي في العمل"}>
        {s.strengths.map((st, i) => (
          <div class="m-item">
            <span class="m-ic"><Icon name={strengthIcons[i]} size={26} /></span>
            <h3>{st.title}</h3>
            <p>{st.body}</p>
          </div>
        ))}
      </section>

      <!-- ============ الأعمال ============ -->
      <section id="work" class="section">
        <header class="section-head">
          <span class="node"></span>
          <h2>{s.sections.work.title}</h2>
          <p>{s.sections.work.intro}</p>
        </header>
        <div class="work-list">
          {workProjects.map((p) => (
            <article class="work">
              <span class="node"></span>
              <div class="work-text">
                <p class="meta">{tx(p.sector, lang)}<span>{p.year}</span></p>
                <h3><a href={workUrl(lang, p.slug)}>{tx(p.title, lang)}</a></h3>
                <p class="sum">{tx(p.summary, lang)}</p>
                <a class="text-link" href={workUrl(lang, p.slug)}>{l.readCase}<span class="sr-only">: {tx(p.title, lang)}</span></a>
              </div>
              <div class="work-visual"><BeforeAfter project={p} lang={lang} /></div>
            </article>
          ))}
        </div>
      </section>

      <!-- ============ المنتجات ============ -->
      <section id="products" class="section">
        <header class="section-head">
          <span class="node"></span>
          <h2>{s.sections.products.title}</h2>
          <p>{s.sections.products.intro}</p>
        </header>
        <div class="products">
          {productProjects.map((p, i) => (
            <article class={`product ${i === 0 ? "wide" : ""}`}>
              <BeforeAfter project={p} lang={lang} size={i === 0 ? "lg" : "sm"} />
              <div class="p-text">
                <p class="meta">{tx(p.sector, lang)}</p>
                <h3><a href={workUrl(lang, p.slug)}>{tx(p.title, lang)}</a></h3>
                <p class="sum">{tx(p.summary, lang)}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- ============ المسيرة ============ -->
      <section id="journey" class="section">
        <header class="section-head">
          <span class="node"></span>
          <h2>{s.sections.journey.title}</h2>
          <p>{s.sections.journey.intro}</p>
        </header>
        <ol class="journey">
          {journey.map((j) => (
            <li>
              <span class="node"></span>
              <span class="period">{tx(j.period, lang)}</span>
              <div>
                <h3>{tx(j.title, lang)}</h3>
                <p class="place">{tx(j.place, lang)}</p>
                <p>{tx(j.body, lang)}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- ============ الإنجازات ============ -->
      <section id="proof" class="section">
        <header class="section-head">
          <span class="node"></span>
          <h2>{s.sections.proof.title}</h2>
          <p>{s.sections.proof.intro}</p>
        </header>
        <ul class="figures">
          {achievements.map((a) => (
            <li><b>{tx(a.figure, lang)}</b><span>{tx(a.label, lang)}</span></li>
          ))}
        </ul>
        <div class="proof-grid">
          <div>
            <h3 class="sub">{l.certs}</h3>
            <ul class="certs">
              {certifications.map((c) => <li><Icon name="check" size={18} />{tx(c, lang)}</li>)}
            </ul>
            <h3 class="sub">{l.tools_title}</h3>
            <ul class="tools">{tools.map((t) => <li>{tx(t, lang)}</li>)}</ul>
          </div>
          <div>
            <h3 class="sub">{l.recommend}</h3>
            {recommendations.map((r) => (
              <blockquote>
                <p>«{tx(r.quote, lang)}»</p>
                <footer><b>{tx(r.by, lang)}</b><span>{tx(r.role, lang)}</span></footer>
              </blockquote>
            ))}
          </div>
        </div>
      </section>
      <div class="rail-end"></div>
    </div>
  </div>

  <!-- ============ التواصل ============ -->
  <section id="contact" class="contact">
    <div class="wrap contact-in">
      <span class="end-node" aria-hidden="true"><Icon name="check" size={18} /></span>
      <h2>{s.sections.contact.title}</h2>
      <p>{s.sections.contact.intro}</p>
      <ul class="channels">
        <li><a href={contact.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" /><span>{l.whatsapp}</span><small dir="ltr">{contact.phoneDisplay}</small></a></li>
        <li><a href={`tel:${contact.phone}`}><Icon name="phone" /><span>{l.call}</span><small dir="ltr">{contact.phoneDisplay}</small></a></li>
        <li><a href={`mailto:${contact.email}`}><Icon name="mail" /><span>{l.email}</span><small dir="ltr">{contact.email}</small></a></li>
        <li><a href={contact.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" /><span>{l.linkedin}</span><small dir="ltr">Mohammed Alshehri</small></a></li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; padding-top: clamp(28px, 4vw, 56px); }
  .hero-grid { display: grid; grid-template-columns: 1.25fr .75fr; gap: clamp(28px, 5vw, 72px); align-items: end; padding-inline-start: calc(var(--gutter) + 0px); }
  .who { font-family: var(--f-display); font-weight: 600; color: var(--ink); font-size: 1.05rem; display: flex; flex-direction: column; gap: 2px; margin-bottom: 18px; }
  .who-role { font-family: var(--f-body); font-weight: 400; color: var(--slate); font-size: .95rem; }
  h1 { font-size: clamp(2.3rem, 5vw, 4rem); line-height: 1.28; font-weight: 700; max-width: 15ch; }
  html[lang="en"] h1 { letter-spacing: -0.035em; line-height: 1.02; max-width: 14ch; }
  .lead { margin-top: 20px; font-size: clamp(1.05rem, 1.5vw, 1.2rem); color: var(--ink-2); max-width: 36rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .focus { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 28px; color: var(--slate); font-size: .95rem; }
  .focus li { display: flex; align-items: center; gap: 8px; }
  .focus li::before { content: ""; inline-size: 7px; block-size: 7px; border-radius: 50%; border: 1.5px solid var(--volt); }

  .portrait { margin: 0; position: relative; inline-size: 100%; max-inline-size: 300px; justify-self: center; isolation: isolate; }
  /* إطار أزرق مزاح خلف الصورة بنفس شكلها */
  .portrait::before { content: ""; position: absolute; inset: 0; transform: translate(-16px, 16px); border-radius: 200px 200px 18px 18px; border: 1.5px solid var(--volt); z-index: -1; }
  :global([dir="rtl"]) .portrait::before { transform: translate(16px, 16px); }
  /* توهج أزرق خفيف */
  .portrait::after { content: ""; position: absolute; inset: 12% 8% -4%; border-radius: 50%; background: radial-gradient(closest-side, rgba(44,102,255,.22), transparent); filter: blur(24px); z-index: -2; }
  .photo { border-radius: 200px 200px 18px 18px; overflow: hidden; background: #fff; aspect-ratio: 895 / 1088; box-shadow: 0 0 0 6px #fff, 0 0 0 7px var(--mist), 0 28px 50px -22px rgba(11,30,63,.45), 0 10px 18px -12px rgba(11,30,63,.25); }
  .photo img { inline-size: 100%; block-size: 100%; object-fit: cover; object-position: center 20%; }
  .badge { position: absolute; inset-inline-start: -40px; inset-block-end: 22px; display: flex; gap: 10px; align-items: center; max-inline-size: 240px; background: var(--ink); color: #fff; padding: 12px 16px; border-radius: 12px; font-size: .86rem; line-height: 1.45; box-shadow: 0 18px 36px -18px rgba(11,30,63,.6); }
  .badge :global(svg) { color: #8fb0ff; flex: none; }

  .strip { position: relative; padding: 0; block-size: 150px; margin-top: clamp(4px, 2vw, 24px); }
  .strip svg { position: absolute; inset-block: 0; inset-inline-start: var(--line-x); inline-size: calc(100% - var(--line-x)); block-size: 150px; overflow: visible; }
  :global([dir="rtl"]) .strip svg { transform: scaleX(-1); }
  .strip path { fill: none; stroke: var(--volt); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 2600; stroke-dashoffset: 2600; animation: draw 2.4s cubic-bezier(.6,.05,.3,1) .35s forwards; }
  .strip-m { display: none; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .tag { position: absolute; top: 14px; font-size: .9rem; color: var(--slate); }
  .tag-hand { font-family: var(--f-hand); font-size: 1.3rem; color: var(--pencil); inset-inline-start: calc(var(--line-x) + 560px); top: 98px; }
  .tag-sys { font-family: var(--f-display); font-weight: 500; color: var(--volt-deep); inset-inline-start: calc(var(--line-x) + 96px); top: 20px; }
  @media (prefers-reduced-motion: reduce) { .strip path { animation: none; stroke-dashoffset: 0; } }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; padding-inline-start: var(--gutter); }
    .portrait { max-inline-size: 230px; order: -1; margin-block: 8px 8px; }
    .badge { inset-inline-start: auto; inset-inline-end: -36px; inset-block-end: -26px; max-inline-size: 220px; font-size: .8rem; padding: 9px 12px; }
    .portrait { margin-block-end: 40px; }
    .strip-d { display: none; } .strip-m { display: block !important; }
    .tag-hand { inset-inline-start: calc(var(--line-x) + 150px); top: 100px; font-size: 1.15rem; }
    .tag-sys { inset-inline-start: calc(var(--line-x) + 30px); top: 22px; font-size: .85rem; }
  }

  /* ---------- Method ---------- */
  .method { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; padding-top: 28px; }
  .m-ic { inline-size: 48px; block-size: 48px; border-radius: 14px; display: grid; place-items: center; background: var(--white); border: 1px solid var(--mist); color: var(--volt); margin-bottom: 16px; }
  .m-item h3 { font-size: 1.15rem; margin-bottom: 6px; }
  .m-item p { color: var(--slate); font-size: .97rem; }
  @media (max-width: 960px) { .method { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .method { grid-template-columns: 1fr; gap: 22px; } }

  /* ---------- Work: لمسة خضراء طبية لقسم القطاع الصحي ---------- */
  #work { --volt: #0e9478; --volt-deep: #0a7660; --volt-soft: #dcf3eb; }
  .work-list { display: grid; gap: clamp(64px, 9vw, 120px); }
  .work { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
  .work:nth-child(even) .work-text { order: 2; }
  .work { position: relative; }
  .work > .node { top: calc(50% - 9px); inset-inline-start: calc(var(--line-x) - var(--gutter) - 8px); }
  .meta { color: var(--volt-deep); font-size: .92rem; display: flex; gap: 12px; margin-bottom: 10px; }
  .meta span { color: var(--slate); }
  .work h3 { font-size: clamp(1.5rem, 2.8vw, 2.1rem); line-height: 1.3; }
  .work h3 a, .product h3 a { text-decoration: none; }
  .work h3 a:hover, .product h3 a:hover { color: var(--volt); }
  .sum { margin-block: 14px 20px; color: var(--ink-2); max-width: 30rem; }
  @media (max-width: 860px) {
    .work { grid-template-columns: 1fr; }
    .work:nth-child(even) .work-text { order: 0; }
    .work > .node { top: 2.4em; }
  }

  /* ---------- Products ---------- */
  .products { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 5vw, 64px) clamp(24px, 4vw, 48px); }
  .product.wide { grid-column: 1 / -1; display: grid; grid-template-columns: .7fr 1.3fr; gap: clamp(24px, 4vw, 56px); align-items: center; }
  .product.wide .p-text { order: -1; }
  .p-text { margin-top: 18px; }
  .product h3 { font-size: 1.35rem; }
  .product.wide h3 { font-size: clamp(1.5rem, 2.8vw, 2.1rem); }
  .product .sum { margin-block: 10px 0; }
  @media (max-width: 860px) {
    .products, .product.wide { grid-template-columns: 1fr; }
    .product.wide .p-text { order: 0; }
  }

  /* ---------- Journey ---------- */
  .journey { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; }
  .journey li { position: relative; display: grid; grid-template-columns: 180px 1fr; gap: 24px; padding-block: 26px; border-top: 1px solid var(--mist); }
  .journey li:last-child { border-bottom: 1px solid var(--mist); }
  .journey .node { top: 32px; inset-inline-start: calc(var(--line-x) - var(--gutter) - 8px); }
  .period { font-family: var(--f-display); font-weight: 600; color: var(--volt-deep); font-size: 1.05rem; }
  .journey h3 { font-size: 1.25rem; }
  .place { color: var(--ink); margin-block: 2px 8px; font-weight: 500; }
  .journey p:last-child { color: var(--slate); max-width: 40rem; }
  @media (max-width: 640px) { .journey li { grid-template-columns: 1fr; gap: 6px; } }

  /* ---------- Proof ---------- */
  .figures { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--mist); border: 1px solid var(--mist); border-radius: 16px; overflow: hidden; }
  .figures li { background: var(--white); padding: 26px 22px; display: grid; gap: 10px; align-content: start; }
  .figures b { font-family: var(--f-display); color: var(--ink); font-size: clamp(1.5rem, 2.6vw, 2.15rem); font-weight: 700; line-height: 1.15; }
  .figures li:first-child b { color: var(--volt); }
  .figures span { color: var(--slate); font-size: .95rem; }
  @media (max-width: 960px) { .figures { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .figures { grid-template-columns: 1fr; } }

  .proof-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); margin-top: clamp(48px, 6vw, 72px); }
  .sub { font-size: 1.2rem; margin-bottom: 18px; }
  .sub:not(:first-child) { margin-top: 40px; }
  .certs { list-style: none; display: grid; gap: 12px; }
  .certs li { display: flex; gap: 10px; align-items: flex-start; }
  .certs :global(svg) { color: var(--volt); flex: none; margin-top: 5px; }
  .tools { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .tools li { padding: 6px 14px; border-radius: 999px; background: var(--white); border: 1px solid var(--mist); font-size: .92rem; color: var(--ink); }
  blockquote { margin: 0 0 22px; padding: 26px 28px; background: var(--white); border: 1px solid var(--mist); border-radius: 16px; }
  blockquote p { font-family: var(--f-display); font-size: 1.2rem; color: var(--ink); line-height: 1.6; font-weight: 500; }
  blockquote footer { margin-top: 16px; display: grid; font-size: .9rem; color: var(--slate); }
  blockquote footer b { color: var(--ink); font-weight: 600; }
  @media (max-width: 860px) { .proof-grid { grid-template-columns: 1fr; } }

  .rail-end { block-size: clamp(80px, 10vw, 120px); }

  /* ---------- Contact ---------- */
  .contact { background: var(--ink); color: #c9d4ea; }
  .end-node { position: absolute; top: -17px; inset-inline-start: calc(var(--line-x) - 16px); inline-size: 34px; block-size: 34px; border-radius: 50%; background: var(--volt); color: #fff; display: grid; place-items: center; box-shadow: 0 0 0 7px var(--paper); }
  .contact-in { position: relative; padding-inline-start: var(--gutter); padding-block: clamp(72px, 10vw, 120px); }
  .contact h2 { color: #fff; font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1.2; max-width: 18ch; letter-spacing: -0.01em; }
  .contact > div > p { margin-top: 18px; font-size: 1.1rem; }
  .channels { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 44px; }
  .channels a { display: grid; gap: 4px; padding: 20px; border-radius: 14px; border: 1px solid #2a3f68; text-decoration: none; color: #fff; transition: background .2s, border-color .2s; }
  .channels a:hover { background: var(--volt); border-color: var(--volt); }
  .channels :global(svg) { color: #8fb0ff; margin-bottom: 8px; }
  .channels a:hover :global(svg) { color: #fff; }
  .channels span { font-family: var(--f-display); font-weight: 500; font-size: 1.05rem; }
  .channels small { color: #9fb0cf; font-size: .85rem; overflow-wrap: anywhere; text-align: start; }
  .channels a:hover small { color: #e6eeff; }
  @media (max-width: 960px) { .channels { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .channels { grid-template-columns: 1fr; } }
</style>
