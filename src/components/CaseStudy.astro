---
// صفحة دراسة الحالة لكل مشروع
import Layout from "../layouts/Layout.astro";
import BeforeAfter from "./BeforeAfter.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site.js";
import { projects } from "../data/projects.js";
import { tx, workUrl, home } from "../data/i18n.js";

const { slug, lang = "ar" } = Astro.props;
const s = site[lang];
const l = s.labels;
const i = projects.findIndex((p) => p.slug === slug);
const p = projects[i];
// التنقل داخل نفس المجموعة (القطاع الصحي أو المشاريع المستقلة)
const group = projects.filter((x) => x.group === p.group);
const gi = group.findIndex((x) => x.slug === slug);
const prev = group[(gi - 1 + group.length) % group.length];
const next = group[(gi + 1) % group.length];
const anchor = p.group === "work" ? "#work" : "#products";
const groupName = p.group === "work" ? s.nav.work : s.sections.products.title;
const allLabel = p.group === "work" ? l.allWork : l.allIndependent;
const backUrl = `${home(lang)}${anchor}`;
---
<Layout lang={lang} title={tx(p.title, lang)} description={tx(p.summary, lang)}>
  <div class="lined">
    <div class="rail"><div class="fill"></div></div>
    <article class={`inner cs ${p.group === "work" ? "care" : ""}`}>
      <nav class="crumbs" aria-label={l.breadcrumb}>
        <ol>
          <li><a href={home(lang)}>{l.homeLink}</a></li>
          <li><a href={backUrl}>{groupName}</a></li>
          <li aria-current="page">{tx(p.title, lang)}</li>
        </ol>
      </nav>
      <a class="back" href={backUrl}><Icon name="back" size={20} class="dir-icon" />{allLabel}</a>

      <header class="cs-head">
        <span class="node"></span>
        <p class="meta">{tx(p.sector, lang)}<span>{p.year}</span></p>
        <h1>{tx(p.title, lang)}</h1>
        <p class="sum">{tx(p.summary, lang)}</p>
        <p class="ctx">{p.group === "work" ? l.employer : l.independent}</p>
      </header>

      <dl class="facts">
        <div><dt>{l.role}</dt><dd>{tx(p.role, lang)}</dd></div>
        <div><dt>{l.tools}</dt><dd>{p.tools.map((t) => tx(t, lang)).join(lang === "en" ? ", " : "، ")}</dd></div>
      </dl>

      <div class="visual"><BeforeAfter project={p} lang={lang} size="lg" /></div>

      <section class="block">
        <span class="node"></span>
        <h2>{l.need}</h2>
        <p class="body">{tx(p.need, lang)}</p>
      </section>

      <section class="block">
        <span class="node"></span>
        <h2>{l.approach}</h2>
        <ol class="steps">
          {p.approach[lang].map((a) => <li>{a}</li>)}
        </ol>
      </section>

      <section class="block">
        <span class="node"></span>
        <h2>{l.results}</h2>
        <ul class="results">
          {p.results[lang].map((r) => <li><Icon name="check" size={20} />{r}</li>)}
        </ul>
      </section>

      <nav class="pager" aria-label={lang === "en" ? "More projects" : "مشاريع أخرى"}>
        <a class="pg prev" href={workUrl(lang, prev.slug)} rel="prev">
          <small><Icon name="back" size={16} class="dir-icon" />{l.prev}</small>
          <span>{tx(prev.title, lang)}</span>
        </a>
        <a class="pg next" href={workUrl(lang, next.slug)} rel="next">
          <small>{l.next}<Icon name="back" size={16} class="dir-icon flip" /></small>
          <span>{tx(next.title, lang)}</span>
        </a>
      </nav>
      <div class="end-links">
        <a class="btn btn-ghost" href={backUrl}><Icon name="back" size={18} class="dir-icon" />{allLabel}</a>
        <a class="btn btn-ghost" href={home(lang)}><Icon name="home" size={18} />{l.backHome}</a>
      </div>
    </article>
  </div>
</Layout>

<style>
  .cs { padding-block: 40px 100px; }
  .cs.care { --volt: #0e9478; --volt-deep: #0a7660; --volt-soft: #dcf3eb; }
  .ctx { margin-top: 14px; font-size: .95rem; color: var(--volt-deep); display: flex; align-items: center; gap: 8px; }
  .ctx::before { content: ""; inline-size: 8px; block-size: 8px; border-radius: 50%; background: var(--volt); flex: none; }
  .crumbs ol { list-style: none; margin: 0 0 14px; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font-size: .9rem; color: var(--slate); }
  .crumbs li { display: flex; align-items: center; gap: 8px; }
  .crumbs li + li::before { content: "/"; color: #b3bfd3; }
  .crumbs a { color: var(--ink-2); text-decoration: none; padding-block: 10px; }
  .crumbs a:hover { color: var(--volt); text-decoration: underline; }
  .crumbs [aria-current] { color: var(--slate); max-inline-size: 26ch; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .back { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px 0 14px; margin-bottom: 36px; border-radius: 999px; background: var(--white); border: 1.5px solid var(--mist); color: var(--ink); font-family: var(--f-display); font-weight: 500; font-size: .95rem; text-decoration: none; transition: border-color .2s, color .2s; }
  :global([dir="rtl"]) .back { padding: 0 14px 0 18px; }
  .back:hover { border-color: var(--volt); color: var(--volt); }
  :global([dir="rtl"]) .cs :global(.dir-icon) { transform: scaleX(-1); }
  .cs :global(.dir-icon.flip) { transform: scaleX(-1); }
  :global([dir="rtl"]) .cs :global(.dir-icon.flip) { transform: none; }
  .cs-head { position: relative; max-width: 50rem; }
  .node { inset-inline-start: calc(var(--line-x) - var(--gutter) - 8px); }
  .cs-head .node { top: 3.1em; }
  .meta { color: var(--volt-deep); font-size: .95rem; display: flex; gap: 12px; margin-bottom: 12px; }
  .meta span { color: var(--slate); }
  h1 { font-size: clamp(2.2rem, 5.4vw, 4rem); line-height: 1.15; letter-spacing: -0.015em; }
  html[lang="en"] h1 { letter-spacing: -0.03em; line-height: 1.05; }
  .sum { margin-top: 20px; font-size: 1.2rem; max-width: 40rem; }
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 40px 0 0; padding-block: 22px; border-block: 1px solid var(--mist); max-width: 50rem; }
  dt { font-size: .88rem; color: var(--slate); }
  dd { margin: 4px 0 0; color: var(--ink); font-weight: 500; }
  .visual { margin-block: 56px 24px; max-width: 860px; }
  .block { position: relative; display: grid; grid-template-columns: 200px 1fr; gap: 24px; padding-block: 40px; border-top: 1px solid var(--mist); max-width: 980px; }
  .block .node { top: 46px; }
  .block h2 { font-size: 1.4rem; }
  .body { font-size: 1.15rem; max-width: 40rem; }
  .steps { margin: 0; padding: 0; list-style: none; counter-reset: s; display: grid; gap: 16px; max-width: 40rem; }
  .steps li { counter-increment: s; display: grid; grid-template-columns: 36px 1fr; gap: 12px; font-size: 1.08rem; }
  .steps li::before { content: counter(s); font-family: var(--f-display); font-weight: 600; color: var(--volt); inline-size: 30px; block-size: 30px; border-radius: 50%; border: 1.5px solid var(--volt); display: grid; place-items: center; font-size: .9rem; }
  .results { list-style: none; display: grid; gap: 12px; }
  .results li { display: flex; gap: 10px; align-items: flex-start; font-size: 1.1rem; color: var(--ink); font-weight: 500; }
  .results :global(svg) { color: var(--volt); flex: none; margin-top: 4px; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 40px; max-width: 980px; }
  .pg { display: grid; gap: 6px; align-content: start; padding: 24px 26px; border-radius: 18px; text-decoration: none; transition: background .2s, border-color .2s; }
  .pg small { display: flex; align-items: center; gap: 6px; font-size: .9rem; }
  .pg span { font-family: var(--f-display); font-weight: 600; font-size: clamp(1.1rem, 2.4vw, 1.5rem); line-height: 1.35; }
  .prev { background: var(--white); border: 1.5px solid var(--mist); color: var(--ink); }
  .prev small { color: var(--slate); }
  .prev:hover { border-color: var(--volt); }
  .next { background: var(--ink); color: #fff; text-align: end; }
  .next small { color: #9fb0cf; justify-content: flex-end; }
  .next:hover { background: var(--volt); } .next:hover small { color: #e6eeff; }
  .end-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
  .end-links .btn { min-height: 44px; }
  @media (max-width: 640px) {
    .pager { grid-template-columns: 1fr; }
    .next { order: -1; text-align: start; } .next small { justify-content: flex-start; }
    .end-links .btn { flex: 1 1 100%; justify-content: center; }
    .cs { padding-block: 24px 64px; }
    .back { margin-bottom: 24px; }
    .visual { margin-block: 32px 8px; }
    .block { padding-block: 28px; }
  }
  @media (max-width: 720px) {
    .block { grid-template-columns: 1fr; gap: 14px; }
    .facts { grid-template-columns: 1fr; }
  }
</style>
